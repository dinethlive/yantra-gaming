# --- Postgres ---
DATABASE_URL=postgresql://yantra_gaming:yantra_gaming_dev@localhost:5434/yantra_gaming

# --- rgs-server ---
# JWT signing for short-lived player session tokens.
# Rotate on a schedule; never reuse across envs.
SESSION_JWT_SECRET=dev-change-me-session-jwt-secret

# JWT signing for operator-portal logins (separate from player sessions).
PORTAL_JWT_SECRET=dev-change-me-portal-jwt-secret

# Master key used to AES-GCM encrypt operator secrets at rest.
# 32 bytes, base64-encoded. In prod this comes from a KMS.
# Dev placeholder below is 32 zero bytes — rotate before ANY real use.
SECRETS_MASTER_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# HTTP + Socket.IO port. 4500 avoids the Windows Hyper-V / WSL dynamic
# exclusion ranges that commonly cover 4000-4400.
PORT=4500
CORS_ORIGIN=http://localhost:3100,http://localhost:3101,http://localhost:4300

# Clock-skew window for inbound HMAC requests (seconds).
SIGNATURE_WINDOW_SECONDS=30

# Base URL of the game-client iframe, used when minting launch URLs.
GAME_CLIENT_BASE_URL=http://localhost:3100

# Timeout on outbound wallet calls. After this we issue a synthetic rollback.
WALLET_CALL_TIMEOUT_MS=5000

NODE_ENV=development

# --- Frontend apps (reference implementations) ---
# The player iframe (apps/game-client), operator back-office
# (apps/operator-portal), and provider admin (apps/provider-admin) ship
# alongside the core RGS backend in this repo. The vars below are the env
# names those apps read — set them when running the reference frontends.
VITE_RGS_BASE_URL=http://localhost:4500
VITE_RGS_SOCKET_URL=http://localhost:4500
VITE_RGS_ADMIN_BASE_URL=http://localhost:4500

# --- mock-operator (dev only) ---
# Lobby + wallet share one Express server on this port. The RGS seed hard-codes
# the wallet callback URL as http://localhost:4300/wallet, so keep this at 4300
# unless you also edit apps/rgs-server/src/seed.ts accordingly.
MOCK_OPERATOR_PORT=4300
RGS_BASE_URL=http://localhost:4500
# Pinned dev UUID so rgs-server seed and mock-operator agree on one id.
MOCK_OPERATOR_ID=00000000-0000-4000-8000-000000000001
MOCK_OPERATOR_API_KEY_ID=kid_mock_dev
MOCK_OPERATOR_API_SECRET=mock-dev-shared-secret
MOCK_OPERATOR_WALLET_SECRET=mock-dev-wallet-secret

# --- OpenTelemetry (optional — leave unset to disable export) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=yantra-rgs
OTEL_LOG_LEVEL=info

# --- Cloudflare Turnstile (optional) ---
# When set, POST /v1/session requires a valid Turnstile token in the
# `cfTurnstileToken` body field or `cf-turnstile-response` header. Obtain
# the secret key from your Cloudflare dashboard > Turnstile > Site > Secret.
# Leave unset to disable Turnstile entirely (default for local dev).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Cert / audit integrity (Tier-0 cert-readiness) ---
# BUILD_HASH: the git SHA (or content hash) of the running server image.
# Stamped on every Round. In production, set this from your CI image tag;
# unset in dev means Round.buildHash is null and the boot attestation
# sweep reports "missing_build_hash".
# BUILD_HASH=

# RGS_CERT_STRICT: when set to "1", EngineRegistry.ensure refuses to start
# an engine whose BUILD_HASH is not matched by a non-expired Certificate
# for the (operator, game, jurisdiction, rngVersion) tuple. Default =
# non-strict; boot sweep logs gaps but serves traffic.
# RGS_CERT_STRICT=1

# AUDIT_ANCHOR_SECRET: HMAC-SHA256 signing key for daily AuditAnchor
# rows. Rotate separately from JWT secrets so anchor signatures survive
# token-key rotation. In dev the service falls back to SESSION_JWT_SECRET.
# Must be >= 16 bytes in production.
# AUDIT_ANCHOR_SECRET=

# REPLAY_SIGNING_SECRET: HMAC-SHA256 signing key for round-replay and
# player-history bundles returned by /v1/rounds/:id/replay and
# /v1/rounds/history. Rotate independently of portal auth.
# REPLAY_SIGNING_SECRET=

# Clock-skew monitor. Pings an NTP server every CLOCK_SKEW_POLL_MS and
# logs a WARN above CLOCK_SKEW_WARN_MS of drift, ERROR above
# CLOCK_SKEW_ERROR_MS. Set CLOCK_SKEW_DISABLED=1 to silence in dev.
# NTP_SERVER=pool.ntp.org
# CLOCK_SKEW_WARN_MS=250
# CLOCK_SKEW_ERROR_MS=2000
# CLOCK_SKEW_POLL_MS=900000
# CLOCK_SKEW_DISABLED=1

# --- Tier-1 operator self-service ---
# DISPUTE_PACK_SIGNING_SECRET: HMAC-SHA256 signing key for the
# dispute-pack bundle. Rotate independently from REPLAY_SIGNING_SECRET.
# Falls back to REPLAY_SIGNING_SECRET, then to PORTAL_JWT_SECRET in dev.
# DISPUTE_PACK_SIGNING_SECRET=

# --- Certificate artefact storage (Tier-2+ follow-ups) ---
# CERT_STORAGE_DIR: where PDF/ZIP artefacts are written when
# CERT_STORAGE_MODE=local (dev default). Must be writable by the
# rgs-server process. Paths outside this directory are rejected.
# CERT_STORAGE_DIR=./.cert-storage
# CERT_STORAGE_MODE=local          # 'local' | 's3' (s3 not yet implemented)

# --- WebAuthn (FIDO2 / passkeys) ---
# WEBAUTHN_RP_ID: the relying-party domain without scheme/port. For
# multi-app deploys this must cover every origin where provider-admin
# or operator-portal is served. Defaults to 'localhost' in dev.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Yantra
# WEBAUTHN_ORIGINS=http://localhost:3103,http://localhost:3101
